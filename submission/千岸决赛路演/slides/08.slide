<Slide style={{ width: 1280, height: 720, background: '#F7F7F5', padding: '32px 64px 0 64px', fontFamily: 'PingFang SC' }}>
    <Box style={{ height: 88 }}>
        <Text style={{ fontSize: 12, fontWeight: 500, letterSpacing: 1.8, color: '#5E6752' }}>BUSINESS · 商业价值</Text>
        <Text style={{ fontSize: 32, fontWeight: 700, color: '#20211E', letterSpacing: -0.4, marginTop: 6, lineHeight: 1.25 }}>谁付钱，为什么是现在</Text>
    </Box>

    <Box style={{ height: 540, flexDirection: 'row', gap: 36 }}>
        <Box style={{ width: 668, justifyContent: 'space-between' }}>
            <Box>
                <Box style={{ background: '#FFFFFF', borderRadius: 10, border: '1px solid #DEDED9', padding: 22 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 12 }}>
                        <Text style={{ fontSize: 17, fontWeight: 600, color: '#20211E', width: 212 }}>中小跨境卖家</Text>
                        <Text style={{ fontSize: 12, color: '#5E6752', fontWeight: 600 }}>数百万量级</Text>
                    </Box>
                    <Text style={{ fontSize: 13, color: '#64645E', lineHeight: 1.6, marginTop: 8 }}>人手少、没有设计资源。以前只敢守得住 1–2 个平台，现在同一份输入能铺满 5 个——长尾市场的门被打开了。</Text>
                </Box>

                <Box style={{ background: '#FFFFFF', borderRadius: 10, border: '1px solid #DEDED9', padding: 22, marginTop: 16 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 12 }}>
                        <Text style={{ fontSize: 17, fontWeight: 600, color: '#20211E', width: 212 }}>跨境品牌大卖</Text>
                        <Text style={{ fontSize: 12, color: '#5E6752', fontWeight: 600 }}>SKU 多 · 上新频次高</Text>
                    </Box>
                    <Text style={{ fontSize: 13, color: '#64645E', lineHeight: 1.6, marginTop: 8 }}>素材生产是规模化的瓶颈。多一条自动出包的产线，就多一批能按时上架的新品。</Text>
                </Box>

                <Box style={{ background: '#FFFFFF', borderRadius: 10, border: '1px solid #DEDED9', padding: 22, marginTop: 16 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 12 }}>
                        <Text style={{ fontSize: 17, fontWeight: 600, color: '#20211E', width: 212 }}>跨境 ISV / ERP 服务商</Text>
                        <Text style={{ fontSize: 12, color: '#5E6752', fontWeight: 600 }}>集成即卖</Text>
                    </Box>
                    <Text style={{ fontSize: 13, color: '#64645E', lineHeight: 1.6, marginTop: 8 }}>把千岸作为上架模块嵌进现有系统——不必自己维护五平台规则库，也不必养一支视觉团队。</Text>
                </Box>
            </Box>

            <Box style={{ background: '#EFEFEB', borderRadius: 10, padding: 24 }}>
                <Text style={{ fontSize: 17, fontWeight: 600, color: '#20211E', lineHeight: 1.5 }}>真正的付费意愿，不在「省了设计费」，<br />而在「敢多铺几个平台」。</Text>
                <Text style={{ fontSize: 12, color: '#64645E', marginTop: 12, lineHeight: 1.6 }}>单品素材成本从千元级压到几十块——省下的钱是次要的，被打开的平台数量才是。</Text>
            </Box>
        </Box>

        <Box style={{ width: 448, background: '#FFFFFF', border: '1px solid #DEDED9', borderRadius: 12, padding: 30, justifyContent: 'space-between' }}>
            <Box>
                <Box style={{ width: 40, height: 2, background: '#5E6752', marginBottom: 18 }} />
                <Text style={{ fontSize: 11, letterSpacing: 2, color: '#5E6752' }}>DELIVERY STATUS</Text>
                <Text style={{ fontSize: 25, fontWeight: 700, color: '#20211E', lineHeight: 1.36, marginTop: 16 }}>不是概念稿，<br />是已经跑在公网上的东西</Text>

                <Box style={{ marginTop: 26, gap: 14 }}>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                        <FAIcon name='check-circle' style={{ fill: '#5E6752', width: 15, height: 15 }} />
                        <Text style={{ fontSize: 13.5, color: '#64645E', flex: 1, lineHeight: 1.45 }}>公网 Demo 在线，前端 HTTP 200</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                        <FAIcon name='check-circle' style={{ fill: '#5E6752', width: 15, height: 15 }} />
                        <Text style={{ fontSize: 13.5, color: '#64645E', flex: 1, lineHeight: 1.45 }}>后端真实模型模式在线（health: mock=false）</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                        <FAIcon name='check-circle' style={{ fill: '#5E6752', width: 15, height: 15 }} />
                        <Text style={{ fontSize: 13.5, color: '#64645E', flex: 1, lineHeight: 1.45 }}>后端 56 项测试通过，含 4 条端到端闭环</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                        <FAIcon name='check-circle' style={{ fill: '#5E6752', width: 15, height: 15 }} />
                        <Text style={{ fontSize: 13.5, color: '#64645E', flex: 1, lineHeight: 1.45 }}>五平台上架包 + 合规报告可导出续查</Text>
                    </Box>
                </Box>
            </Box>

            <Box style={{ paddingTop: 20, borderTop: '1px solid #EDEDE9' }}>
                <Text style={{ fontSize: 11, color: '#858580' }}>SOURCE</Text>
                <Text style={{ fontSize: 13, color: '#20211E', marginTop: 8 }}>github.com/gxinxing/qianan</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 60, borderTop: '1px solid #DEDED9', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 12, color: '#858580', letterSpacing: 0.3 }}>千岸 QianAn · Simon Studio</Text>
        <Text style={{ fontSize: 12, color: '#858580', letterSpacing: 1.2 }}>08 / 10</Text>
    </Box>
</Slide>
