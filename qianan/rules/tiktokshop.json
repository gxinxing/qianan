{
  "version": "v1",
  "platform": "tiktokshop",
  "displayName": "TikTok Shop",
  "updated": "2025-09",
  "source": "TikTok Shop Seller Center · Product Specifications & Content Requirements",
  "demoDepth": "standard",
  "locales": ["en-US", "th-TH", "id-ID", "vi-VN", "en-GB"],
  "marketplaces": ["TikTok Shop US", "TikTok Shop UK", "TikTok Shop SEA (TH/ID/VN)"],
  "title": {
    "maxLength": 100,
    "recommendedLength": [40, 70],
    "formula": "[Hook] + Product + Key Benefit + Variant",
    "mustIncludeKeywords": true,
    "caseStyle": "sentence_case",
    "note": "标题需吸引短视频观众注意，前 10 字最关键"
  },
  "bullets": {
    "count": 0,
    "style": "none",
    "note": "TikTok Shop 无独立五点；卖点融入 product_description + video_script"
  },
  "description": {
    "maxLength": 2000,
    "type": "product_card",
    "minLength": 50,
    "supportsHtml": false,
    "plainText": true,
    "structuredSections": ["一句话卖点", "3 条核心卖点", "规格参数", "使用说明"],
    "tiktokTone": "短促有力，口语化，适合短视频口播与直播话术"
  },
  "productCard": {
    "headlineMaxLength": 100,
    "sellingPointsMaxCount": 5,
    "sellingPointsMaxLength": 60,
    "ctaRequired": true,
    "tone": "casual hooky"
  },
  "videoScript": {
    "type": "short_form_15s_60s",
    "structure": ["hook_3s", "problem", "demo", "cta"],
    "suggestedDuration": "15-60s",
    "mustInclude": ["品牌名称", "核心卖点", "价格信息（可选）", "购买引导"],
    "style": "ASMR / 评测 / 对比 / 开箱 / 教程"
  },
  "aPlus": {
    "modules": ["轮播图说明", "卖点图文", "规格表", "用户评价模板"],
    "requireApproval": false,
    "maxModules": 10,
    "primaryLanguage": "en-US",
    "note": "TikTok Shop 用图片轮播（Product Carousel）替代 A+"
  },
  "mainImage": {
    "background": "any",
    "minWidth": 500,
    "minHeight": 500,
    "recommendedSize": [1200, 1200],
    "noText": false,
    "noWatermark": false,
    "noBorder": true,
    "productFillRatio": 0.75,
    "acceptedFormats": ["JPEG", "PNG", "WebP"],
    "maxFileSizeKB": 3000,
    "ratio1v1": true,
    "note": "TikTok Shop 主图可含文字/场景风格，强调吸引眼球"
  },
  "additionalImages": {
    "recommendedCount": 5,
    "maxCount": 9,
    "carouselMaxSlides": 10,
    "infoGraphics": true,
    "lifestyleImages": true,
    "demoImages": true,
    "reviewImages": true
  },
  "categoryAttributes": {
    "electronics": ["品牌", "型号", "颜色", "存储容量", "屏幕尺寸", "电池容量", "产地", "保修期"],
    "home_kitchen": ["品牌", "材质", "容量", "尺寸", "颜色", "产地", "是否可微波炉"],
    "apparel": ["品牌", "材质", "尺码", "颜色", "款式", "产地"],
    "beauty": ["品牌", "功效", "肤质", "容量", "成分", "产地", "是否防水"],
    "sports": ["品牌", "材质", "尺寸", "重量", "颜色", "产地"],
    "accessories": ["品牌", "材质", "尺寸", "颜色", "产地", "适用设备"],
    "food": ["品牌", "净含量", "口味", "保质期", "成分", "产地", "储存方式"]
  },
  "bannedWords": {
    "promotional": ["sale", "discount", "promotion", "coupon", "deal"],
    "claims": ["#1", "best seller", "best selling", "guaranteed results", "guaranteed", "100% effective", "100% safe (未认证)", "FDA approved (未认证)", "#1 ranked"],
    "misleading": ["official (未授权)", "authentic (无证明)", "original (无证明)", "patented (未申请)", "clinically proven (无证据)"],
    "offensive": ["粗俗用语", "宗教敏感词", "政治敏感词"],
    "restricted": ["仿冒品", "侵权产品", "管制药品", "武器", "烟草", "未成年人禁用品"],
    "trademark": ["apple (非授权)", "samsung (非授权)", "nike (非授权)", "adidas (非授权)"],
    "tiktokSpecific": [
      "虚假折扣划线价（原价须真实）",
      "诱导站外交易",
      "限时抢购倒计时（需真实）",
      "刷单/刷评引导"
    ]
  },
  "complianceChecks": [
    {
      "id": "tts-title-001",
      "type": "length",
      "severity": "error",
      "field": "title",
      "message": "标题超过 100 字符限制",
      "max": 100
    },
    {
      "id": "tts-title-002",
      "type": "banned_words",
      "severity": "error",
      "field": "title",
      "message": "标题命中禁用词",
      "dict": "claims",
      "fields": ["title"]
    },
    {
      "id": "tts-desc-001",
      "type": "length",
      "severity": "error",
      "field": "description",
      "message": "描述超过 2000 字符限制",
      "max": 2000
    },
    {
      "id": "tts-desc-002",
      "type": "required_sections",
      "severity": "warn",
      "field": "description",
      "message": "描述缺少短视频脚本结构",
      "sections": ["卖点", "hook"]
    },
    {
      "id": "tts-img-001",
      "type": "image_spec",
      "severity": "warn",
      "field": "mainImage",
      "message": "主图尺寸不足（建议 ≥500×500）",
      "minWidth": 500,
      "minHeight": 500
    },
    {
      "id": "tts-img-002",
      "type": "banned_words",
      "severity": "warn",
      "field": "description",
      "message": "描述含促销用语",
      "dict": "promotional",
      "fields": ["description", "title"]
    },
    {
      "id": "tts-attr-001",
      "type": "required_attrs",
      "severity": "warn",
      "field": "attributes",
      "message": "缺少必填类目属性"
    },
    {
      "id": "tts-script-001",
      "type": "required_sections",
      "severity": "info",
      "field": "description",
      "message": "短视频脚本建议包含：hook / 痛点 / 演示 / CTA",
      "sections": ["hook", "痛点", "演示", "cta"]
    },
    {
      "id": "tts-locale-001",
      "type": "locale_coverage",
      "severity": "info",
      "field": "locales",
      "message": "东南亚市场建议本地化语言",
      "locales": ["th-TH", "id-ID", "vi-VN"]
    }
  ],
  "economics": {
    "commissionRate": 0.05,
    "commissionNote": "普通类目约 5%（具体依 TikTok Shop 佣金表）",
    "adTacosDefault": 0.15,
    "returnRateDefault": 0.15,
    "returnHandlingFee": 0.0,
    "fulfillment": {
      "type": "fulfilled_by_tiktok",
      "note": "FBT (Fulfilled by TikTok) 履约服务"
    },
    "vatRate": 0.07,
    "vatNote": "泰国 7% VAT；印尼 11%；越南 10%；英国 VAT 20%（平台代扣）",
    "dutyNote": "部分站点含关税预付服务"
  }
}
