# ===== 黑客松 Token Plan 专属网关（实测可用，2026-09-01）=====
# 专属 API Key（菜鸟黑客松 Token Plan 发放，勿提交到代码仓库！）
BAILIAN_API_KEY=
# 专属基地址（必须与专属 key 配套；用通用 dashscope 地址不抵扣套餐）
BAILIAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ===== 模型选择（以套餐模型清单为准）=====
# 文本：qwen3.8-max / qwen3.7-max / qwen3.7-plus / qwen3.6-flash ...
QIANAN_TEXT_MODEL=qwen3.7-max
# 图片生成：qwen-image-2.0 / qwen-image-2.0-pro / wan2.7-image / wan2.7-image-pro
# 注意：图片模型走 /chat/completions 路由 + 列表格式 content（客户端已封装）
QIANAN_IMAGE_MODEL=qwen-image-2.0
# 视觉理解：当前网关无 VL 模型，留空 = 商品理解走纯文本路径
QIANAN_VL_MODEL=

# ===== 调试 =====
# 1 = 强制 Mock 模式（不调用真实 API，演示兜底 / 无网联调用）
QIANAN_MOCK=0

# ===== 鉴权（默认关闭：演示依赖游客免登录直连）=====
# 1 = 打开登录墙（生成/发布/技能安装等写接口需登录）；开启时必须设置 JWT secret，否则启动即失败
QIANAN_REQUIRE_AUTH=0
# HS256 签名密钥，仅 REQUIRE_AUTH=1 时必填；生成方式：openssl rand -hex 32
QIANAN_JWT_SECRET=
