# ===== 环境变量备份（可能含真实密钥，严禁入库）=====
.env.bak*

# ===== 运行时数据（服务器运行产生的 jsonl；data/skills、data/evals 等代码性资产不受影响）=====
qianan/server/data/*.jsonl
qianan/server/data/evolution/*.jsonl
qianan/server/data/memory/*.jsonl
qianan/server/data/metrics/*.jsonl
qianan/server/data/mock_seller/*.jsonl
qianan/server/data/publish/*.jsonl
# 运行时计数/用户映射（游客 uid 由 IP+UA 派生，非密钥，但属运行态不应入库）
qianan/server/data/users.json
qianan/server/data/wan_image_quota.json

# ===== 会话迁移记录（AI 对话导出，不入库）=====
会话记录*.md

# ===== SCF/部署构建产物（可由 SCF_DEPLOY.md 重建，不入库）=====
qianan/server/deploy_pkg/
qianan/server/deploy.zip
qianan/server/cloudfunctions/

# ===== 发布执行留痕（运行时产物）=====
qianan/server/data/publish/pub-*/

# ===== 构建实验残留垃圾（2026-09-07 清理，防复发）=====
qianan/web/.next.trash*/
qianan/web/.next-trash*/
qianan/web/out.trash*/
qianan/web/out-trash*/
qianan/web/.taskId-trash/
