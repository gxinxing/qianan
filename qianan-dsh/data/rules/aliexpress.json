{
  "version": "v1",
  "platform": "aliexpress",
  "displayName": "AliExpress Global",
  "updated": "2025-09",
  "source": "AliExpress Seller Center · Publishing Rules",
  "demoDepth": "reuse",
  "locales": ["en-US", "ru-RU", "pt-BR", "es-ES", "fr-FR", "id-ID", "th-TH", "vi-VR"],
  "marketplaces": ["aliexpress.com"],
  "title": {
    "maxLength": 128,
    "recommendedLength": [60, 100],
    "formula": "Core Keyword + Product Feature + Material + Use Scenario",
    "mustIncludeKeywords": false
  },
  "bullets": {
    "count": 5,
    "maxLengthPer": 500,
    "style": "paragraph",
    "note": "AliExpress 多用长描述替代分段 bullet，details 字段为主要描述区"
  },
  "description": {
    "maxLength": 5000,
    "type": "rich_text"
  },
  "mainImage": {
    "background": "white",
    "minWidth": 800,
    "minHeight": 800,
    "noText": false,
    "noWatermark": true,
    "noBorder": true,
    "productFillRatio": 0.80,
    "note": "AliExpress 允许图片带少量促销文字（如 'Free Shipping'），但限制严格"
  },
  "galleryImages": {
    "count": 5,
    "maxCount": 6,
    "note": "首图为白底主图，后续为场景图/卖点图/尺码图"
  },
  "categoryAttributes": {
    "electronics": ["品牌", "型号", "电压", "功率", "材质", "颜色", "接口类型", "产地"],
    "home_kitchen": ["品牌", "材质", "容量", "尺寸", "颜色", "产地", "是否易碎"],
    "apparel": ["品牌", "材质", "尺码", "颜色", "款式", "产地", "季节"]
  },
  "bannedWords": {
    "promotional": ["cheap", "cheapest", "low price", "clearance", "closeout", "liquidated"],
    "claims": ["best", "#1", "top rated", "guarantee", "warranty (除非明确标注期限)", "official", "authorized"],
    "restricted": ["FDA", "CE (若无认证)", "patented", "copyrighted"],
    "trademark": ["apple (非授权)", "nike (非授权)", "adidas (非授权)"]
  },
  "complianceChecks": [
    { "id": "ali-title-001", "type": "length", "severity": "error", "field": "title", "max": 128 },
    { "id": "ali-title-002", "type": "banned_words", "severity": "error", "field": "title", "dict": "claims" },
    { "id": "ali-desc-001", "type": "length", "severity": "error", "field": "description", "max": 5000 },
    { "id": "ali-desc-002", "type": "banned_words", "severity": "error", "field": "description", "dict": "promotional" },
    { "id": "ali-img-001", "type": "image_spec", "severity": "error", "field": "mainImage", "minWidth": 800, "minHeight": 800 },
    { "id": "ali-attr-001", "type": "required_attrs", "severity": "warn", "field": "attributes" },
    { "id": "ali-bullet-001", "type": "count", "severity": "warn", "field": "bullets", "min": 3, "max": 5 }
  ],
  "economics": {
    "commissionRate": 0.05,
    "adTacosDefault": 0.10,
    "returnRateDefault": 0.07,
    "returnHandlingFee": 1.20,
    "fulfillment": {
      "type": "standard",
      "fee": 3.50
    },
    "vatRate": 0.0,
    "dutyNote": "目的国关税由买家承担（DDP/DDU 模式）"
  }
}
